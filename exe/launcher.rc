#include <windows.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @V1@,@V2@,@V3@,0
 PRODUCTVERSION  @V1@,@V2@,@V3@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104b0"
    BEGIN
      VALUE "CompanyName",      "SEVENTHWELL"
      VALUE "FileDescription",  "SW NAS WATCH"
      VALUE "FileVersion",      "@VER@"
      VALUE "InternalName",     "SW_NAS_WATCH"
      VALUE "LegalCopyright",   "Copyright (c) 2026 SEVENTHWELL. All rights reserved."
      VALUE "OriginalFilename", "SW_NAS_WATCH.exe"
      VALUE "ProductName",      "SW NAS WATCH"
      VALUE "ProductVersion",   "@VER@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0411, 1200
  END
END
